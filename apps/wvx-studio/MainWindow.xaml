<Window
    x:Class="WvxStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WVX Studio">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151720" Padding="20,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="38" Height="38" CornerRadius="13" Background="#30344A">
                    <TextBlock Text="W" Foreground="{StaticResource AccentBrush}" FontSize="21" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="WVX Studio" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="DESKTOP CONTROL" FontSize="9" CharacterSpacing="120" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="WORKSPACE" FontSize="10" CharacterSpacing="140"
                       Foreground="{StaticResource MutedBrush}" Margin="8,0,0,11" />
            <StackPanel Grid.Row="3" Spacing="6">
                <Button x:Name="OverviewNav" Tag="Overview" Click="OnNavigate" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="Overview" /></StackPanel>
                </Button>
                <Button x:Name="WidgetsNav" Tag="Widgets" Click="OnNavigate" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xECA5;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="Widgets" /></StackPanel>
                </Button>
                <Button x:Name="AppearanceNav" Tag="Appearance" Click="OnNavigate" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="Appearance" /></StackPanel>
                </Button>
                <Button x:Name="ProfilesNav" Tag="Profiles" Click="OnNavigate" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="Profiles &amp; settings" /></StackPanel>
                </Button>
            </StackPanel>
            <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="13">
                <StackPanel Spacing="8">
                    <TextBlock Text="Runtime connection" FontSize="12" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#E3AC6A" VerticalAlignment="Center" />
                        <TextBlock x:Name="SidebarStatusText" Text="Checking runtime…" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,29,38,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitle" Text="Overview" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Your desktop, thoughtfully redesigned." Foreground="{StaticResource MutedBrush}" FontSize="13" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="↻   Refresh runtime" Click="OnRefresh" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border Grid.Row="2" x:Name="StatusBanner" CornerRadius="12" Padding="14,11" Background="#332C251C">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:Name="BannerDot" Width="8" Height="8" Fill="#E3AC6A" VerticalAlignment="Center" />
                        <TextBlock x:Name="BannerText" Text="Connecting to the WVX runtime…" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="RuntimeName" Text="wvx-runtime-v1" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="17" Padding="0,0,4,8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="23">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Your desktop, in balance" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Manage your live GlassDesk setup from one place." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="12" Padding="13">
                                            <StackPanel Spacing="7"><TextBlock Text="ACTIVE WIDGETS" FontSize="9" CharacterSpacing="70" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="WidgetCount" Text="2" FontSize="23" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{StaticResource PanelRaisedBrush}" CornerRadius="12" Padding="13">
                                            <StackPanel Spacing="7"><TextBlock Text="CURRENT THEME" FontSize="9" CharacterSpacing="70" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="ThemeSummary" Text="One UI Frosted" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource PanelRaisedBrush}" CornerRadius="12" Padding="13">
                                            <StackPanel Spacing="7"><TextBlock Text="PROFILE" FontSize="9" CharacterSpacing="70" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="ProfileSummary" Text="Work" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                    </Grid>
                                    <Button Content="Configure widgets  →" Tag="Widgets" Click="OnNavigate" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#25263A" CornerRadius="18" Padding="22">
                                <StackPanel Spacing="15">
                                    <StackPanel Spacing="4"><TextBlock Text="Appearance settings" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Runtime values · renderer support varies" FontSize="12" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                                    <Border Height="1" Background="#3A3B50" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Saved blur preference · not rendered" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="BlurSummary" Grid.Column="1" Text="24" FontWeight="SemiBold" /></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Tint opacity · renderer active" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="TintSummary" Grid.Column="1" Text="55%" FontWeight="SemiBold" /></Grid>
                                    <Button Content="Adjust appearance  →" Tag="Appearance" Click="OnNavigate" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="21">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Quick status" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="ConnectionDetail" Text="Settings are read from the runtime; changes are only sent when you apply them." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="WidgetsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="15" Padding="0,0,4,8">
                        <TextBlock Text="Choose which GlassDesk widgets are enabled. Changes remain a draft until applied to the running runtime." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="21">
                            <StackPanel Spacing="4">
                                <CheckBox x:Name="ClockCheck" Content="Clock" Tag="clock" Checked="OnWidgetChanged" Unchecked="OnWidgetChanged" Style="{StaticResource SettingCheckBoxStyle}" />
                                <TextBlock Text="Available — activation is consumed by the native renderer." Foreground="{StaticResource MutedBrush}" Margin="31,0,0,10" />
                                <TextBlock Text="Weather" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="PLANNED · NOT AVAILABLE" FontSize="10" CharacterSpacing="70" Foreground="#E3AC6A" Margin="31,3,0,10" />
                                <TextBlock Text="System monitor" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="PLANNED · NOT AVAILABLE" FontSize="10" CharacterSpacing="70" Foreground="#E3AC6A" Margin="31,3,0,10" />
                                <TextBlock Text="Media player" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="PLANNED · NOT AVAILABLE" FontSize="10" CharacterSpacing="70" Foreground="#E3AC6A" Margin="31,3,0,10" />
                                <TextBlock Text="Calendar" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="PLANNED · NOT AVAILABLE" FontSize="10" CharacterSpacing="70" Foreground="#E3AC6A" Margin="31,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ApplyWidgetsButton" Content="Apply widget settings" Click="OnApply" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="15" Padding="0,0,4,8">
                        <TextBlock Text="Tune the material and shape of your desktop." Foreground="{StaticResource MutedBrush}" />
                        <Border Background="#352C21" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Renderer support" FontWeight="SemiBold" Foreground="#F0C48A" />
                                <TextBlock Text="Theme, tint opacity, corner radius, and clock activation are currently consumed by the native renderer. Blur, refraction, and dispersion are saved preferences only; the native renderer does not apply them yet." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="21">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Theme · consumed by renderer" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Choose a look for your widgets." Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="ThemeCombo" SelectedIndex="0" SelectionChanged="OnThemeChanged" MinWidth="250" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="One UI Frosted" Tag="OneUiFrosted" />
                                    <ComboBoxItem Content="Liquid Glass" Tag="LiquidGlass" />
                                    <ComboBoxItem Content="Liquid Glass Clear" Tag="LiquidGlassClear" />
                                    <ComboBoxItem Content="Minimal" Tag="Minimal" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="21">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Appearance preferences" FontSize="15" FontWeight="SemiBold" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Blur · saved preference only" FontWeight="SemiBold" /><TextBlock Text="Not applied by native renderer yet" Foreground="{StaticResource MutedBrush}" /></StackPanel><TextBlock x:Name="BlurValue" Grid.Column="1" Text="24" VerticalAlignment="Center" /></Grid>
                                <Slider x:Name="BlurSlider" Minimum="0" Maximum="100" Value="24" ValueChanged="OnMaterialSliderChanged" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tint opacity · consumed by renderer" FontWeight="SemiBold" /><TextBlock Text="Strength of the colored surface tint" Foreground="{StaticResource MutedBrush}" /></StackPanel><TextBlock x:Name="TintValue" Grid.Column="1" Text="55%" VerticalAlignment="Center" /></Grid>
                                <Slider x:Name="TintSlider" Minimum="0" Maximum="100" Value="55" ValueChanged="OnMaterialSliderChanged" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Corner radius · consumed by renderer" FontWeight="SemiBold" /><TextBlock Text="Widget corner roundness" Foreground="{StaticResource MutedBrush}" /></StackPanel><TextBlock x:Name="CornerValue" Grid.Column="1" Text="28" VerticalAlignment="Center" /></Grid>
                                <Slider x:Name="CornerSlider" Minimum="0" Maximum="64" Value="28" ValueChanged="OnMaterialSliderChanged" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Refraction · saved preference only" FontWeight="SemiBold" /><TextBlock Text="Not applied by native renderer yet (0–1)" Foreground="{StaticResource MutedBrush}" /></StackPanel><TextBlock x:Name="RefractionValue" Grid.Column="1" Text="0.35" VerticalAlignment="Center" /></Grid>
                                <Slider x:Name="RefractionSlider" Minimum="0" Maximum="1" Value="0.35" ValueChanged="OnMaterialSliderChanged" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dispersion · saved preference only" FontWeight="SemiBold" /><TextBlock Text="Not applied by native renderer yet (0–1)" Foreground="{StaticResource MutedBrush}" /></StackPanel><TextBlock x:Name="DispersionValue" Grid.Column="1" Text="0.04" VerticalAlignment="Center" /></Grid>
                                <Slider x:Name="DispersionSlider" Minimum="0" Maximum="1" Value="0.04" ValueChanged="OnMaterialSliderChanged" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ApplyAppearanceButton" Content="Apply appearance" Click="OnApply" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="15" Padding="0,0,4,8">
                        <TextBlock Text="Select the profile associated with this runtime settings set." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="21">
                            <StackPanel Spacing="13">
                                <TextBlock Text="Active profile" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="The selected name is sent with your settings; the runtime owns profile persistence. No settings are saved on this device." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <ComboBox x:Name="ProfileCombo" SelectedIndex="0" SelectionChanged="OnProfileChanged" MinWidth="250" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Work" Tag="Work" />
                                    <ComboBoxItem Content="Gaming" Tag="Gaming" />
                                    <ComboBoxItem Content="Minimal" Tag="Minimal" />
                                    <ComboBoxItem Content="PowerSaving" Tag="PowerSaving" />
                                </ComboBox>
                                <Button x:Name="ApplyProfileButton" Content="Apply profile" Click="OnApply" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="21">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Runtime settings" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="WVX Studio does not keep a separate local copy. Refresh reads the current runtime configuration; Apply sends changes to the runtime over the named pipe. Applying is unavailable until a runtime settings read succeeds." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Pipe: \\.\pipe\wvx-runtime-v1" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <TextBlock x:Name="FooterMessage" Text="Changes are sent directly to the runtime." FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
